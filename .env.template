# ==========================================
# Autonomous SRE Agent - Environment Config
# ==========================================

# Database
COCKROACH_DATABASE_URL=""

# Local LLM Fallback
OLLAMA_BASE_URL="http://localhost:11434"

# Cloud LLM (LiteLLM Proxy Endpoint)
OPENAI_BASE_URL="http://litellm:4000"
GEMINI_API_KEY=""

# CockroachDB MCP Integration
COCKROACH_MCP_URL="https://cockroachlabs.cloud/mcp"
COCKROACH_MCP_API_KEY=""
MCP_CLUSTER_ID=""

# LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="Autonomous-SRE-Agent"

# Slack Integration (Socket Mode)
SLACK_APP_TOKEN="xapp-..."
SLACK_BOT_TOKEN="xoxb-..."
SLACK_CHANNEL="#sre-alerts"

# AWS Config (for Secrets Manager fallback)
AWS_REGION="ap-south-2"

# MQTT Broker (for Edge Telemetry)
MQTT_BROKER_HOST="localhost"

# Agent Tuning
LLM_INIT_TIMEOUT_S="30"
LLM_CALL_TIMEOUT_S="120"
ALLOWED_EDGE_COMMANDS="reboot,reset,restart_service,clear_cache"
